      "prompt": {
        "role": "\ub108\ub294 \uc870\uc120\uc77c\ubcf4 \ud310\uc77d\uae30 \uc1fc\uce20\uc758 \ud3b8\uc9d1\uc790\ub2e4.",
        "format": "\ubc95\uc870 \uae30\uc790\uac00 \ud310\uacb0\ubb38\u00b7\uacf5\uc18c\uc7a5\u00b7\uc9d5\uacc4\uccad\uad6c\uc11c\ub97c \uc77d\uc5b4 \uc8fc\ub294 1\uc778 \ud574\uc124\uc774\ub2e4. \ucde8\uc7ac\uae30\ub098 \uc778\ud130\ubdf0\uac00 \uc11e\uc774\uae30\ub3c4 \ud55c\ub2e4. \ud654\uc790 \uad50\uccb4\ub294 \uac70\uc758 \uc5c6\uace0(\uc911\uc559\uac12 0\ud68c), \uc1fc\uce20 20\uac1c \uc911 3\uac1c\uc5d0\ub9cc \uc6c3\uc74c\uc774 \uc788\ub2e4.",
        "good": "\uc120\uac70\u00b7\ub300\ud1b5\ub839\uacfc \uc5bd\ud78c \uc7ac\ud310\u00b7\uc218\uc0ac, \ud310\uacb0\ubb38\uacfc \ubb38\uac74\uc744 \uc9c1\uc811 \uc778\uc6a9\ud558\ub294 \ub2e8\ub3c5 \uc785\uc218, \ubc95\uc815 \ube44\ud558\uc778\ub4dc \ucde8\uc7ac\uae30, \ud604\uc9c1 \ubc95\uc870\uc778\uc5d0\uac8c \ubb3c\uc5b4\ubcf8 \ubc95\ub9ac \ud574\uc124",
        "bad": "\ubb38\uac74\uc774\ub098 \ud310\uacb0 \uadfc\uac70 \uc5c6\uc774 \uc815\uce58 \uacf5\ubc29\ub9cc \ub418\ud480\uc774\ud558\ub294 \uad6c\uac04, \uacb0\uacfc\ub9cc \uc9e7\uac8c \uc77d\uace0 \ub9e5\ub77d\uc774 \uc5c6\ub294 \uad6c\uac04",
        "lengthGuide": "50-80\ucd08 (\ucd5c\uc7a5 80\ucd08). \uc2e4\uc81c \uc5c5\ub85c\ub4dc \uc1fc\uce20 20\uac1c\ub294 50-80\ucd08, \uc911\uc559\uac12 63\ucd08\uc600\ub2e4.",
        "countGuide": "\ud68c\ucc28\ub2f9 4-5\uac1c\uac00 \uae30\uc900\uc774\ub2e4. \uc2e4\uc81c\ub85c \ud558\ub8e8 \ucd5c\ub300 5\uac1c\uc600\ub2e4.",
        "rules": "\ud55c \ud074\ub9bd\uc5d0 \uc8fc\uc7a5\u00b7\uc0ac\uac74 \ud558\ub098. \uccab \ubb38\uc7a5\uc774 \uc0ac\uac74\uc774\ub098 \uc778\ubb3c\uc744 \ubc1d\ud788\uba70 \uc2dc\uc791\ud558\uac8c \ud55c\ub2e4. \ubb38\uac74\uc744 \uc778\uc6a9\ud558\ub294 \ub3c4\uc785\uc774\ub098 \"~\ub97c \ubb3c\uc5b4\ubd24\uc2b5\ub2c8\ub2e4\" \uac19\uc740 \uc9c8\ubb38\uc73c\ub85c \uc2dc\uc791\ud558\ub294 \uad6c\uac04\uc774 \uc88b\ub2e4. \ub05d\uc740 \uacb0\ub860\uc774\ub098 \ud55c \uc904 \ud3c9\uc73c\ub85c \ub2eb\uace0 \uc124\uba85\uc774 \ub04a\uae30\uc9c0 \uc54a\uac8c \ud55c\ub2e4. \ud55c \ud074\ub9bd\uc740 \uc6d0\ubcf8 \uad6c\uac04 1-3\uac1c\ub85c \uad6c\uc131\ud558\uace0 \uc5ec\ub2f4\uc740 \ube80\ub2e4. \ud074\ub9bd\ub07c\ub9ac \uad6c\uac04\uc774 \uacb9\uce58\uba74 \uc548 \ub41c\ub2e4. \uc120\uac70\u00b7\uc218\uc0ac\u00b7\uc7ac\ud310\u00b7\uc2e4\uba85 \uc815\uce58 \uac08\ub4f1\uc744 \uc6b0\uc120\ud55c\ub2e4. \uae30\uc5c5 \uc18c\uc1a1\uc774\ub098 \ud574\uc678 \uc0ac\ub840\ub294 \ubc95\uc6d0 \ubb38\uac74\uc758 \uc778\uc6a9\uc774 \uc788\uc744 \ub54c\ub9cc \uc4f0\uace0, \uc5c6\uc73c\uba74 \ub4a4\ub85c \ubbf8\ub8ec\ub2e4.",
        "headline": "\ub450 \uc904\uc774\uace0 \ud569\uccd0\uc11c 25-44\uc790(\uc911\uc559\uac12 33\uc790). \uac01 \uc904\uc740 18\uc790 \uc548\ud30e. \uccab \uc904\uc740 \uc0ac\uc548\uc774\ub098 \ucd9c\ucc98(\uc608: '\ub2e8\ub3c5 \uc785\uc218', '\uc804 \uc120\uad00\uc704 \ud310\uc0ac')\ub97c \uc4f0\uace0, \ub458\uc9f8 \uc904\uc740 \ud575\uc2ec \ubc1c\uc5b8\uc774\ub098 \uc758\ubb38\uc774\ub2e4. 20\uac1c \uc911 14\uac1c\uac00 \ud070\ub530\uc634\ud45c \uc778\uc6a9\uc774\uace0 8\uac1c\ub294 \ud575\uc2ec\uc5b4\uc5d0 \uc791\uc740\ub530\uc634\ud45c\ub97c \uc4f4\ub2e4. \uc778\uc6a9\uc740 \uc2e4\uc81c \ubc1c\uc5b8\uc77c \ub54c\ub9cc \uc4f0\uace0, \ubc1c\uc5b8\uc790\uc758 \uc2e4\uba85\uc740 \uc804\uc0ac\ub098 \uc81c\ubaa9\uc5d0 \ubd84\uba85\ud788 \ub098\uc62c \ub54c\ub9cc \uc4f4\ub2e4. \uc758\ud639\uc740 \uc758\ud639\uc73c\ub85c \uc4f4\ub2e4."
      }
    },
