      "good": "\uc9c8\ubb38\uc5d0 \ub300\ud55c \ubd84\uba85\ud55c \ub2f5, \uadfc\uac70\ub97c \ub3d9\ubc18\ud55c \uc0c8\ub85c\uc6b4 \uc124\uba85, \uc785\uc7a5 \ucc28\uc774\ub97c \uc774\ud574\ud558\uac8c \ud558\ub294 \ub300\ubaa9, \uc2dc\uccad\uc790\uac00 \ubc30\uacbd\uc744 \ubab0\ub77c\ub3c4 \uc774\ud574\ud560 \uc218 \uc788\ub294 \uc644\uacb0\ub41c \ubb38\ub2f5.",
      "bad": "\uc790\uadf9\uc801\uc778 \ub2e8\uc5b4\ub9cc \ub5bc\uc5b4\ub0b8 \ubc1c\uc5b8, \ubc18\ub860\uc774\ub098 \ub2e8\uc11c\ub97c \uc798\ub77c\ub0b8 \uc8fc\uc7a5, \ubc30\uacbd \uc5c6\uc774\ub294 \uc774\ud574\ud558\uae30 \uc5b4\ub824\uc6b4 \uc778\uba85 \ub098\uc5f4, \uc778\uc0ac\u00b7\ud64d\ubcf4\u00b7\ubc29\uc1a1 \uc548\ub0b4.",
      "lengthGuide": "45\u201375\ucd08 \uad8c\uc7a5. \ub9e5\ub77d\uacfc \uacb0\ub860\uc744 \ubcf4\uc874\ud558\ub294 \uacbd\uc6b0\uc5d0\ub9cc 110\ucd08 \uc774\ub0b4.",
      "countGuide": "\uc11c\ub85c \ub2e4\ub978 \uc644\uacb0\ub41c \uc7c1\uc810\uc774 \uc788\ub294 \ub9cc\ud07c\ub9cc \uc81c\uc548\ud55c\ub2e4. \ubd84\ub7c9\uc744 \ucc44\uc6b0\uae30 \uc704\ud55c \uc911\ubcf5\uc774\ub098 \uc57d\ud55c \ub300\ubaa9\uc740 \uc81c\uc678\ud55c\ub2e4.",
      "headline": "\uccab \uc904\uc740 \uc9e7\uace0 \uac15\ud55c \uc7c1\uc810, \ub458\uc9f8 \uc904\uc740 \uad81\uae08\uc99d\uc744 \ubd80\ub974\ub294 \uc9c8\ubb38 \ub610\ub294 \ubc1c\uc5b8\uc758 \ud575\uc2ec \ub2f5\ubcc0\uc73c\ub85c \uc4f4\ub2e4. \uac01 \uc904\uc740 \uacf5\ubc31 \ud3ec\ud568 12\uc790 \uc774\ub0b4\ub97c \ubaa9\ud45c\ub85c \ud558\uba70 \ub450 \uc904\uc744 \ub118\uae30\uc9c0 \uc54a\ub294\ub2e4. \uc608: \ud398\ub178\uba54\ub17c \uacc4\uc57d / \uc65c \ud2b9\ud61c \uc758\ud639?, \uacf5\uc775\uc131 \uc870\ud56d 3\uac1c / \uacc4\uc57d\uc11c\uc5d4 \uc5c6\ub2e4?, \ub300\uc678\ube44 \uc720\ucd9c \ub17c\ub780 / \ubc30\ud604\uc9c4\uc758 \ubc18\ubc15. \ub208\uae38\uc744 \ub04c\ub418 \uc6d0\ubb38\uc5d0 \uc5c6\ub294 \uc0ac\uc2e4\u00b7\ub2e8\uc815\uc744 \ub9cc\ub4e4\uac70\ub098 \uc758\ud639\uc744 \ud655\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc2e4\uc81c \ubc1c\uc5b8\uc774 \uc544\ub2cc \ubb38\uad6c\uc5d0 \ub530\uc634\ud45c\ub97c \ubd99\uc774\uc9c0 \uc54a\ub294\ub2e4.",
      "rules": "\uc6d0\ubb38\uc5d0 \uc788\ub294 \ubc1c\uc5b8\ub9cc \uc0ac\uc6a9\ud55c\ub2e4. \uc9c8\ubb38\uacfc \ub2f5\ubcc0, \uc870\uac74\u00b7\uc720\ubcf4\u00b7\ubc18\ub860\uc744 \ubcf4\uc874\ud558\uace0 \ubc1c\uc5b8\uc758 \ucde8\uc9c0\ub97c \ubc14\uafb8\uc9c0 \uc54a\ub294\ub2e4. \uc758\ud639\u00b7\uc8fc\uc7a5\u00b7\uc804\ub9dd\uc740 \ud655\uc815 \uc0ac\uc2e4\ub85c \ubc14\uafb8\uc9c0 \uc54a\ub294\ub2e4. \uc778\ubb3c\u00b7\uae30\uad00\u00b7\ub0a0\uc9dc\u00b7\uc218\uce58\u00b7\ub2e8\uc704\ub97c \uc6d0\ubb38\uacfc \ub300\uc870\ud55c\ub2e4. \uac00\ub2a5\ud558\uba74 \ud558\ub098\uc758 \uc5f0\uc18d\ub41c \uad6c\uac04\uc744 \uc0ac\uc6a9\ud558\uba70 \uc11c\ub85c \ub2e4\ub978 \ubc1c\uc5b8\uc744 \uc774\uc5b4 \uc0c8 \uc758\ubbf8\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \ubb38\uc7a5 \uc911\uac04\uc5d0\uc11c \uc2dc\uc791\ud558\uac70\ub098 \ub05d\ub0b4\uc9c0 \ub9d0\uace0 \uacb0\ub860\uae4c\uc9c0 \ub2f4\ub294\ub2e4. \uc5ec\ub7ec \ud074\ub9bd\uc740 \ud575\uc2ec \ub0b4\uc6a9\uc774 \uc911\ubcf5\ub418\uc9c0 \uc54a\uac8c \uace0\ub978\ub2e4. \ucd9c\ucc98\ub294 \uc720\uc9c0\ud55c\ub2e4. \uc815\uce58\uc1fc\ub294 \uc6d0\ubcf8 \ud558\ub2e8 \uc790\ub9c9\uc774 \uc0c8 \uc790\ub9c9\uacfc \uacb9\uce58\uc9c0 \uc54a\ub3c4\ub85d \uc778\ubb3c \uc911\uc2ec \ud06c\ub86d\uc744 \uc0ac\uc6a9\ud558\ub418 TV\u00b7\uc790\ub8cc \ud654\uba74\u00b7\ud22c\uc0f7\uc740 \uc7a5\uba74\ubcc4 \ud655\uc778\uc774 \ud544\uc694\ud558\ub2e4. \uc790\ub9c9\uc5d0\uc11c\ub9cc \ubb34\uc758\ubbf8\ud55c \ucd94\uc784\uc0c8\u00b7\uc2e4\ud328\ud55c \ub9d0 \uc2dc\uc791\uc744 \uc228\uae30\uace0 \uc74c\uc131\u00b7\uc601\uc0c1\uc740 \ubcf4\uc874\ud55c\ub2e4. \uc758\ubbf8 \uc788\ub294 \ub2f5\ubcc0\uacfc \uac15\uc870 \ubc18\ubcf5\uc740 \ubcf4\uc874\ud55c\ub2e4. \uc27c\ud45c\ub294 \ud45c\uc2dc\ud558\uc9c0 \uc54a\ub294\ub2e4."
    },
