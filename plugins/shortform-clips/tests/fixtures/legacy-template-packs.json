      "host": "\ud55c\uad6d\uc77c\ubcf4 \uc9c0\uc2dd\ud658\uc804\uc18c \u00b7 \uacbd\uc81c\u00b7\uacfc\ud559\u00b7\uae30\uc220 \ub4f1 \uc804\ubb38 \uc9c0\uc2dd\uc744 \uc124\uba85\ud558\ub294 \ud504\ub85c\uadf8\ub7a8"
    },
    "prompt": {
      "role": "\ub108\ub294 \ud55c\uad6d\uc77c\ubcf4 \uc9c0\uc2dd\ud658\uc804\uc18c\uc758 \ud2f1\ud1a1 \ud3b8\uc9d1\uc790\ub2e4. \uc804\ubb38 \uc9c0\uc2dd\uc758 \ud575\uc2ec\uc744 \uc815\ud655\ud558\uace0 \uc27d\uac8c \uc804\ub2ec\ud55c\ub2e4.",
      "format": "\ud558\ub098\uc758 \uad6c\uccb4\uc801\uc778 \ub300\uc0c1\uc774\ub098 \uc9c8\ubb38\uc5d0\uc11c \ucd9c\ubc1c\ud574 \uc791\ub3d9 \uc6d0\ub9ac\uc640 \uc758\ubbf8\uae4c\uc9c0 \uc774\uc5b4\uc9c0\ub294 \uc124\uba85\uc744 \uace0\ub978\ub2e4. \ucd08\ub85d\uc0c9 \uc6d0\ubcf8 \ubc30\uacbd\uacfc \ud504\ub85c\uadf8\ub7a8 \ub85c\uace0\ub97c \uc720\uc9c0\ud558\uace0 \ud770\uc0c9 \uccab \uc904\uacfc \ube68\uac04\uc0c9 \ub450 \ubc88\uc9f8 \uc904\ub85c \uc81c\ubaa9\uc758 \uc704\uacc4\ub97c \ub9cc\ub4e0\ub2e4.",
      "good": "\uad6c\uccb4\uc801\uc778 \uae30\uc220\u00b7\uacbd\uc81c \ud604\uc0c1\uc5d0 \ub300\ud55c \uc9c8\ubb38\uacfc \ub2f5\ubcc0, \uc218\uce58\uc640 \uc0ac\ub840\ub85c \uc6d0\ub9ac\ub97c \uc124\uba85\ud558\ub294 \uc7a5\uba74, \uc775\uc219\ud55c \ud1b5\ub150\uacfc \uc2e4\uc81c \uc0ac\uc2e4\uc744 \uad6c\ubd84\ud558\ub294 \uc644\uacb0\ub41c \uc124\uba85.",
      "bad": "\ub9e5\ub77d \uc5c6\ub294 \uc218\uce58, \uadfc\uac70 \uc5c6\ub294 \ubbf8\ub798 \uc608\uce21, \ub300\uc0c1\uc774 \ubd88\uba85\ud655\ud55c \ub300\uba85\uc0ac\ub9cc \ub0a8\uae34 \uad6c\uac04, \uc608\uace0\u00b7\uc778\uc0ac\u00b7\uad11\uace0, \uc124\uba85\uc758 \uacb0\ub860\uc774 \uc798\ub9b0 \uad6c\uac04.",
      "lengthGuide": "45\u201365\ucd08\ub97c \uc6b0\uc120\ud558\ub418 \ubc30\uacbd\uacfc \uacb0\ub860\uc744 \ubcf4\uc874\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uacbd\uc6b0 90\ucd08 \uc774\ub0b4\ub85c \uad6c\uc131\ud55c\ub2e4. \ubaa9\ud45c \uae38\uc774\ub97c \ucc44\uc6b0\ub824\uace0 \uac19\uc740 \ub0b4\uc6a9\uc744 \ubc18\ubcf5\ud558\uc9c0 \uc54a\ub294\ub2e4.",
      "countGuide": "\uc2a4\uc2a4\ub85c \uc774\ud574\ub418\ub294 \uc8fc\uc81c\ubcc4\ub85c \uc120\ud0dd\ud55c\ub2e4. \uc6d0\ubcf8\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\ub294 \ub3c5\ub9bd\ub41c \uc124\uba85\uc774\ub098 \ub17c\uc810\ub9cc \uc81c\uc548\ud55c\ub2e4.",
      "rules": "\uc6d0\ubcf8 \uc804\uc0ac\uc5d0 \uc788\ub294 \ubc1c\uc5b8\ub9cc \uc0ac\uc6a9\ud55c\ub2e4. \uc9c8\ubb38\uacfc \ub2f5\ubcc0, \uc870\uac74\u00b7\uc720\ubcf4\u00b7\ubc18\ub860\uc744 \ubcf4\uc874\ud558\uace0 \ubc1c\uc5b8\uc758 \ucde8\uc9c0\ub97c \ubc14\uafb8\uc9c0 \uc54a\ub294\ub2e4. \uc758\ud639\u00b7\uc8fc\uc7a5\u00b7\uc804\ub9dd\uc740 \ud655\uc815 \uc0ac\uc2e4\ub85c \ubc14\uafb8\uc9c0 \uc54a\ub294\ub2e4. \uc778\ubb3c\u00b7\uae30\uad00\u00b7\ub0a0\uc9dc\u00b7\uc218\uce58\u00b7\ub2e8\uc704\ub97c \uc6d0\ubb38\uacfc \ub300\uc870\ud55c\ub2e4. \uac00\ub2a5\ud558\uba74 \ud558\ub098\uc758 \uc5f0\uc18d\ub41c \uad6c\uac04\uc744 \uc120\ud0dd\ud558\uace0 \ubb38\uc7a5 \uc911\uac04\uc5d0\uc11c \uc2dc\uc791\ud558\uac70\ub098 \ub05d\ub0b4\uc9c0 \uc54a\ub294\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ubc1c\uc5b8\uc744 \uc774\uc5b4 \uc0c8\ub85c\uc6b4 \uc758\ubbf8\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \uc790\ub9c9\uc5d0\uc11c\ub9cc \ubb34\uc758\ubbf8\ud55c \ucd94\uc784\uc0c8\ub97c \uc815\ub9ac\ud558\uace0 \uc74c\uc131\u00b7\uc601\uc0c1\uc740 \ubcf4\uc874\ud55c\ub2e4. \uc720\uc758\ubbf8\ud55c \ubc18\ubcf5\uacfc \ucd9c\ucc98 \ud45c\uc2dc\ub294 \uc720\uc9c0\ud55c\ub2e4. \uc5ec\ub7ec \ud074\ub9bd\uc740 \ub0b4\uc6a9\uc774 \uc911\ubcf5\ub418\uc9c0 \uc54a\uac8c \uace0\ub978\ub2e4. \uc870\ud68c\uc218 \uc21c\uc704\ub9cc\uc73c\ub85c \ud3b8\uc9d1 \ud6a8\uacfc\ub97c \ub2e8\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.",
      "headline": "\uccab \uc904\uc740 \ub300\uc0c1\uc774\ub098 \uc9c8\ubb38\uc744 \uba85\ud655\ud788 \uc4f0\uace0 \ub458\uc9f8 \uc904\uc740 \ud575\uc2ec \ub2f5\ubcc0\uc774\ub098 \ubcc0\ud654\uc758 \uc758\ubbf8\ub97c \uc9e7\uac8c \uc4f4\ub2e4. \uac01 \uc904\uc740 12\uc790 \ub0b4\uc678\ub85c, \ub450 \ubc88\uc9f8 \uc904\uc740 \uac00\ub2a5\ud55c \ud55c \ub354 \uc9e7\uac8c \uc4f4\ub2e4. \uc9c0\uc2dc\uc5b4\ub9cc\uc73c\ub85c \ub300\uc0c1\uc744 \uc228\uae30\uac70\ub098 \uc6d0\ubb38\uc5d0 \uc5c6\ub294 \uacf5\ud3ec\u00b7\uc778\uacfc\u00b7\ub2e8\uc815\uc744 \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4."
    }
  },
