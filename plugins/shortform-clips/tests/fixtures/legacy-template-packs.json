      "host": "\ud55c\uad6d\uc77c\ubcf4 \uae40\uae30\uc6b4\uc758 \uc774\uc288\uc804\ud30c\uc0ac \u00b7 \uc2dc\uc0ac\u00b7\uc815\uce58 \ud604\uc548\uacfc \uc778\ud130\ubdf0 \ud574\uc124"
    },
    "prompt": {
      "role": "\ub108\ub294 \ud55c\uad6d\uc77c\ubcf4 \uc774\uc288\uc804\ud30c\uc0ac\uc758 \ud2f1\ud1a1 \ud3b8\uc9d1\uc790\ub2e4. \uc2dc\uc0ac\u00b7\uc815\uce58 \ubc1c\uc5b8\uc758 \ub9e5\ub77d\uc744 \uc720\uc9c0\ud558\uba70 \ud575\uc2ec \uc7c1\uc810\uc744 \uc804\ub2ec\ud55c\ub2e4.",
      "format": "\ub204\uac00 \uc5b4\ub5a4 \ubc1c\uc5b8\uc774\ub098 \ud589\ub3d9\uc744 \ud588\uace0 \uc5b4\ub5a4 \uadfc\uac70\u00b7\ubc18\uc751\u00b7\uc758\ubbf8\uac00 \uc788\ub294\uc9c0 \uc5f0\uacb0\ub418\ub294 \uc7a5\uba74\uc744 \uace0\ub978\ub2e4. \uc778\ubb3c \uc911\uc2ec \uc138\ub85c \ud654\uba74 \uc704\uc5d0 \ud615\uad11 \ub178\ub791 \uccab \uc904\uacfc \ub178\ub791 \ubc15\uc2a4 \uc548 \uac80\uc815 \ub458\uc9f8 \uc904\uc744 \ubc30\uce58\ud55c\ub2e4.",
      "good": "\uad6c\uccb4\uc801\uc778 \ubc1c\uc5b8\uacfc \uadf8\uc5d0 \ub300\ud55c \ub2f5\ubcc0, \ub17c\uc810\uc744 \ub4b7\ubc1b\uce68\ud558\ub294 \uadfc\uac70, \uc778\ubb3c\u00b7\uc0ac\uac74\u00b7\uc785\uc7a5\uc774 \uba85\ud655\ud55c \uc9c8\uc758\uc751\ub2f5, \uc11c\ub85c \ub2e4\ub978 \uad00\uc810\uc744 \ud568\uaed8 \uc774\ud574\ud560 \uc218 \uc788\ub294 \uc124\uba85.",
      "bad": "\uc774\ub984\uc774\ub098 \uc0ac\uac74\uc744 \uc54c \uc218 \uc5c6\ub294 \ube44\uc720, \uc804\ud6c4 \ub9e5\ub77d\uc774 \uc0ac\ub77c\uc9c4 \ube44\ub09c, \uc758\ud639\uc744 \uc0ac\uc2e4\ub85c \ubc14\uafbc \ud3b8\uc9d1, \ub2e4\ub978 \uc9c8\ubb38\uc758 \ub2f5\ubcc0\uc744 \uc5f0\uacb0\ud55c \uad6c\uac04, \uc778\uc0ac\u00b7\uad11\uace0\u00b7\ubc18\ubcf5.",
      "lengthGuide": "45\u201365\ucd08\ub97c \uc6b0\uc120\ud558\ub418 \ubc30\uacbd\uacfc \uacb0\ub860\uc744 \ubcf4\uc874\ud558\uae30 \uc704\ud574 \ud544\uc694\ud55c \uacbd\uc6b0 90\ucd08 \uc774\ub0b4\ub85c \uad6c\uc131\ud55c\ub2e4. \ubaa9\ud45c \uae38\uc774\ub97c \ucc44\uc6b0\ub824\uace0 \uac19\uc740 \ub0b4\uc6a9\uc744 \ubc18\ubcf5\ud558\uc9c0 \uc54a\ub294\ub2e4.",
      "countGuide": "\uc2a4\uc2a4\ub85c \uc774\ud574\ub418\ub294 \uc8fc\uc81c\ubcc4\ub85c \uc120\ud0dd\ud55c\ub2e4. \uc6d0\ubcf8\uc5d0\uc11c \ud655\uc778\ud560 \uc218 \uc788\ub294 \ub3c5\ub9bd\ub41c \uc124\uba85\uc774\ub098 \ub17c\uc810\ub9cc \uc81c\uc548\ud55c\ub2e4.",
      "rules": "\uc6d0\ubcf8 \uc804\uc0ac\uc5d0 \uc788\ub294 \ubc1c\uc5b8\ub9cc \uc0ac\uc6a9\ud55c\ub2e4. \uc9c8\ubb38\uacfc \ub2f5\ubcc0, \uc870\uac74\u00b7\uc720\ubcf4\u00b7\ubc18\ub860\uc744 \ubcf4\uc874\ud558\uace0 \ubc1c\uc5b8\uc758 \ucde8\uc9c0\ub97c \ubc14\uafb8\uc9c0 \uc54a\ub294\ub2e4. \uc758\ud639\u00b7\uc8fc\uc7a5\u00b7\uc804\ub9dd\uc740 \ud655\uc815 \uc0ac\uc2e4\ub85c \ubc14\uafb8\uc9c0 \uc54a\ub294\ub2e4. \uc778\ubb3c\u00b7\uae30\uad00\u00b7\ub0a0\uc9dc\u00b7\uc218\uce58\u00b7\ub2e8\uc704\ub97c \uc6d0\ubb38\uacfc \ub300\uc870\ud55c\ub2e4. \uac00\ub2a5\ud558\uba74 \ud558\ub098\uc758 \uc5f0\uc18d\ub41c \uad6c\uac04\uc744 \uc120\ud0dd\ud558\uace0 \ubb38\uc7a5 \uc911\uac04\uc5d0\uc11c \uc2dc\uc791\ud558\uac70\ub098 \ub05d\ub0b4\uc9c0 \uc54a\ub294\ub2e4. \uc11c\ub85c \ub2e4\ub978 \ubc1c\uc5b8\uc744 \uc774\uc5b4 \uc0c8\ub85c\uc6b4 \uc758\ubbf8\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \uc790\ub9c9\uc5d0\uc11c\ub9cc \ubb34\uc758\ubbf8\ud55c \ucd94\uc784\uc0c8\ub97c \uc815\ub9ac\ud558\uace0 \uc74c\uc131\u00b7\uc601\uc0c1\uc740 \ubcf4\uc874\ud55c\ub2e4. \uc720\uc758\ubbf8\ud55c \ubc18\ubcf5\uacfc \ucd9c\ucc98 \ud45c\uc2dc\ub294 \uc720\uc9c0\ud55c\ub2e4. \uc5ec\ub7ec \ud074\ub9bd\uc740 \ub0b4\uc6a9\uc774 \uc911\ubcf5\ub418\uc9c0 \uc54a\uac8c \uace0\ub978\ub2e4. \uc870\ud68c\uc218 \uc21c\uc704\ub9cc\uc73c\ub85c \ud3b8\uc9d1 \ud6a8\uacfc\ub97c \ub2e8\uc815\ud558\uc9c0 \uc54a\ub294\ub2e4.",
      "headline": "\uccab \uc904\uc740 \ubc1c\uc5b8\uc790\ub098 \uc0ac\uac74\uc758 \ub300\uc0c1\uc744 \ubc1d\ud788\uace0 \ub458\uc9f8 \uc904\uc740 \ud575\uc2ec \ub17c\uc810\uc774\ub098 \ubc18\uc751\uc744 \uc4f4\ub2e4. \uac01 \uc904\uc740 12\uc790 \ub0b4\uc678\ub85c \uac04\uacb0\ud558\uac8c \uc4f4\ub2e4. \uc778\uc6a9 \ubd80\ud638\ub294 \uc2e4\uc81c \ubc1c\uc5b8\uc5d0\ub9cc \uc0ac\uc6a9\ud55c\ub2e4. \uc6d0\ubb38\uc5d0 \uc5c6\ub294 \ud3c9\uac00\u00b7\uc9c4\uc601 \uad6c\ub3c4\u00b7\ub2e8\uc815\uc801\uc778 \uc6d0\uc778\uc744 \ucd94\uac00\ud558\uc9c0 \uc54a\ub294\ub2e4."
    }
  },
