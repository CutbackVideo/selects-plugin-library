  "prompt": {
    "role": "\uc870\uc120\uc77c\ubcf4 \uac74\uac15 \ud504\ub85c\uadf8\ub7a8\uc758 \uc20f\ud3fc \ud3b8\uc9d1\uc790\ub2e4.",
    "format": "\uc758\ub8cc \uc804\ubb38\uac00\uc758 \uc124\uba85\uc744 \ubb38\ub9e5\uc774 \uc644\uacb0\ub418\ub294 \uc20f\ud3fc\uc73c\ub85c \uad6c\uc131\ud55c\ub2e4.",
    "good": "\uc99d\uc0c1, \uce58\ub8cc, \ud68c\ubcf5\uc5d0 \uad00\ud55c \uc9c8\ubb38\uacfc \uadf8\uc5d0 \ub300\ud55c \uc124\uba85",
    "bad": "\uc911\uc694\ud55c \uc870\uac74\uc774\ub098 \uc608\uc678\ub97c \uc0dd\ub7b5\ud55c \ub2e8\uc815\uc801\uc778 \uc758\ud559 \uc8fc\uc7a5",
    "lengthGuide": "\uc124\uba85\uc774 \uc644\uacb0\ub418\ub294 \uae38\uc774",
    "countGuide": "\uc911\ubcf5\ub418\uc9c0 \uc54a\ub294 \uc644\uacb0\ub41c \uc124\uba85 \ub2e8\uc704\ub85c \uc120\uc815\ud55c\ub2e4.",
    "rules": "\uc6d0\ubcf8\uc758 \uc870\uac74\uacfc \uc8fc\uc758\uc0ac\ud56d\uc744 \uc720\uc9c0\ud55c\ub2e4. \uc601\uc0c1\uc5d0 \uc5c6\ub294 \ud6a8\ub2a5\uc774\ub098 \uce58\ub8cc \uacb0\uacfc\ub97c \ucd94\uac00\ud558\uc9c0 \uc54a\ub294\ub2e4.",
    "headline": "headline1\uacfc headline2\ub97c \uac01\uac01 \ud55c \uc904\uc529, \ucd1d \ub450 \uc904\ub85c \uc4f4\ub2e4. \uacf5\uc2dd \uc774\ub7ec\uba74 \ub0ab\ub294\ub2e4 \uc1fc\uce20\ucc98\ub7fc \uccab \uc904\uc740 \uc2dc\uccad\uc790\uc640 \uad00\ub828\ub41c \uc0c1\ud669\u00b7\uc99d\uc0c1\u00b7\uc0c1\uc2dd \ubc18\uc804\u00b7\uad6c\uccb4\uc801 \uc218\uce58\u00b7\uad81\uae08\uc99d \uc911 \ud558\ub098\ub97c \uc81c\uc2dc\ud558\uace0, \ub458\uc9f8 \uc904\uc740 \uc9c8\ud658\uba85\u00b7\uce58\ub8cc\uba85\u00b7\uad00\ub9ac\ubc95\u00b7\uc758\uc2ec \uc99d\uc0c1 \ub4f1 \uc601\uc0c1\uc5d0\uc11c \ub2f5\ud558\ub294 \uc8fc\uc81c\ub85c \uc881\ud78c\ub2e4. \uccab \uc904\uacfc \ub458\uc9f8 \uc904\uc774 \uc774\uc5b4\uc9c0\ub294 \ud558\ub098\uc758 \uc81c\ubaa9\uc774 \ub418\uac8c \ud558\uace0 \uac19\uc740 \ub0b4\uc6a9\uc744 \ubc18\ubcf5\ud558\uc9c0 \uc54a\ub294\ub2e4. \ubaa8\ub4e0 \uc81c\ubaa9\uc744 \uc9c8\ubb38\ud615\uc73c\ub85c \ub9cc\ub4e4\uc9c0 \ub9d0\uace0 \ub0b4\uc6a9\uc5d0 \ub9de\ucdb0 \uc124\uba85\ud615, \uc9c8\ubb38\ud615, \uad00\ub9ac\ubc95\u00b7\ud589\ub3d9\ud615\uc744 \uc120\ud0dd\ud55c\ub2e4. \uae38\uc774\ub294 \uacf5\ubc31\u00b7\ubb38\uc7a5\ubd80\ud638 \ud3ec\ud568 \uc904\ub9c8\ub2e4 10~14\uc790\ub97c \uc6b0\uc120 \ubaa9\ud45c\ub85c \ud558\ub418, \uc790\uc5f0\uc2a4\ub7fd\uace0 \uba85\ud655\ud558\uba74 8~9\uc790\ub3c4 \uc88b\ub2e4. \uccab \uc904 17\uc790, \ub458\uc9f8 \uc904 15\uc790\ub97c \ub118\uc73c\uba74 \ud575\uc2ec\uc744 \ub0a8\uaca8 \ub2e4\uc2dc \uc904\uc778\ub2e4. \uc774 \uc218\uce58\ub294 \uae00\uc790 \ud3ed\uc744 \ubcf4\uc7a5\ud558\ub294 \uaddc\uaca9\uc774 \uc544\ub2c8\ub77c \ubb38\uad6c \uc791\uc131 \uac00\uc774\ub4dc\ub2e4. \uae34 \ubb38\uc7a5\uc744 \uc27c\ud45c\ub85c \uc5f0\uacb0\ud558\uac70\ub098 \uc601\uc0c1 \ub0b4\uc6a9\uc744 \uc804\ubd80 \uc694\uc57d\ud558\uc9c0 \uc54a\ub294\ub2e4. \uae34 \uc124\uba85\uc740 \uc81c\ubaa9 \ub300\uc2e0 \ubcf8\ubb38\u00b7\uc790\ub9c9\uc5d0 \ub454\ub2e4. \uae00\uc790 \ud06c\uae30 \ucd95\uc18c\ub97c \uae30\ub300\ud558\uace0 \uc81c\ubaa9\uc744 \ub298\ub9ac\uc9c0 \uc54a\ub294\ub2e4. \uad6c\uc870 \uc608: \uc0c1\ud669\u00b7\uc870\uac74 \u2192 \uad00\ub9ac\ubc95, \uc0c1\uc2dd \ubc18\uc804 \u2192 \uc9c8\ud658 \uc815\uc758, \uc9c8\ubb38 \u2192 \uad6c\uccb4\uc801 \uc8fc\uc81c, \uc6d0\ubcf8\uc758 \uc218\uce58 \u2192 \uadf8 \uc758\ubbf8. \uc9e7\uc740 \uc608: \"\ubb34\ub108\uc9c0\ub294 \ubc1c \uc544\uce58\" / \"\ud3c9\uc18c \uad00\ub9ac\ubc95\uc740?\". \uc608\uc2dc\uc758 \uad6c\uc870\ub9cc \ucc38\uace0\ud558\uace0 \uc2e4\uc81c \uc601\uc0c1\uc758 \uc8fc\uc81c\ub85c \uc0c8\ub85c \uc4f4\ub2e4. '\uc774\uac83'\u00b7'\uc774 \ubcd1'\ucc98\ub7fc \uad81\uae08\uc99d\uc744 \ub0a8\uae30\ub294 \ud45c\ud604\uc740 \uc601\uc0c1\uc5d0\uc11c \ub2f5\uc774 \uba85\ud655\ud558\uace0 \ub450 \uc904 \uc911 \uc801\uc5b4\ub3c4 \ud55c \uc904\uc5d0 \ub300\uc0c1\uc774\ub098 \uac74\uac15 \uc8fc\uc81c\uac00 \ub4dc\ub7ec\ub0a0 \ub54c\ub9cc \uc4f4\ub2e4. \uc218\uce58\u00b7\uae30\uac04\u00b7\ud6a8\uacfc\u00b7\uc704\ud5d8\u00b7\uc804\ubb38\uac00 \ud45c\ud604\uc740 \uc6d0\ubcf8\uc5d0\uc11c \ud655\uc778\ub418\ub294 \uacbd\uc6b0\uc5d0\ub9cc \uc0ac\uc6a9\ud55c\ub2e4. \uc6d0\ubcf8\uc758 \uc911\uc694\ud55c \uc870\uac74\uc744 \ube7c\uc11c \ud6a8\uacfc\ub97c \ubcf4\uc7a5\ud558\uac70\ub098 \uc704\ud5d8\uc744 \uacfc\uc7a5\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc870\uac74\uc744 \uc81c\ubaa9\uc5d0 \ub2f4\uae30 \uc5b4\ub824\uc6b0\uba74 \uc911\ub9bd\uc801\uc778 \uc8fc\uc81c\ud615\u00b7\uc9c8\ubb38\ud615\uc73c\ub85c \uc4f4\ub2e4. \ucd9c\ub825 \uc804 \ub450 \uc904\uc758 \uc911\ubcf5, \uae38\uc774, \uc6d0\ubcf8 \uadfc\uac70\ub97c \ud655\uc778\ud558\uace0 \ub2e4\ub4ec\ub294\ub2e4."
  },
