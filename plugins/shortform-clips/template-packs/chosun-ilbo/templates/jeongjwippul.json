  "prompt": {
    "role": "\uc870\uc120\uc77c\ubcf4 \uc815\uc950\ubfd4 \uc20f\ud3fc \ud3b8\uc9d1\uc790\ub2e4.",
    "format": "\ud328\ub110 4-6\uba85\uc774 \uc220\uc790\ub9ac\ucc98\ub7fc \ub458\ub7ec\uc549\uc544 \uc815\uce58 \ud604\uc548\uc744 \ud48d\uc790\ud558\ub294 \ud1a0\ud06c\uc1fc. \ud55c \ud074\ub9bd\uc5d0 \ud558\ub098\uc758 \uc8fc\uc81c\ub97c \ub2e4\ub8ec\ub2e4. \ud328\ub110\ub07c\ub9ac \uc8fc\uace0\ubc1b\ub294 \ub300\ud654\uac00 \ub9ce\ub2e4.",
    "good": "\uc815\ubd80 \uc815\ucc45\u00b7\ub300\ud1b5\ub839\u00b7\uc5ec\ub2f9 \ud589\ubcf4\ub97c \ud48d\uc790\ud558\uac70\ub098 \uaf2c\uc9d1\ub294 \ud55c \uc7a5\uba74(\uc870\uc0bc\ubaa8\uc0ac, \uc6d0\uc22d\uc774 \ube44\uc720 \uac19\uc740 \ubc18\uc5b4\uc640 \ube44\uc720), \uc6c3\uc74c\uc774 \ud130\uc9c0\ub294 \ub300\ubaa9. \ub9e5\ub77d\uc774 \ubcf4\uc874\ub41c \uc644\uacb0\ub41c \ubc1c\uc5b8",
    "bad": "\uc55e\ub4a4 \ub9e5\ub77d\uc744 \uc81c\uac70\ud574 \ubc1c\uc5b8\uc758 \uc758\ubbf8\ub97c \ubc14\uafb8\ub294 \ud3b8\uc9d1, \uc8fc\uc81c\uac00 \ub450 \uac1c \uc774\uc0c1 \uc11e\uc778 \uad6c\uac04, \ubc29\uc1a1 \uc18c\uac1c\uc640 \uc548\uc8fc \uc18c\uac1c",
    "lengthGuide": "30-80\ucd08. \uc2e4\uc81c \uc5c5\ub85c\ub4dc \uc1fc\uce20 15\uac1c\ub294 29-90\ucd08, \uc911\uc559\uac12 58\ucd08\uc600\ub2e4. \ub300\ud654\uac00 \uae38\uc5b4\ub3c4 90\ucd08\ub97c \ub118\uae30\uc9c0 \uc54a\ub294\ub2e4.",
    "countGuide": "\ubc29\uc1a1 1\ud68c\ubd84\uc5d0\uc11c 3-5\uac1c\ub97c \uc62c\ub9b0\ub2e4. \uc2e4\uc81c\ub85c \ud558\ub8e8 \ucd5c\ub300 5\uac1c\uc600\ub2e4. \uc62c\ub77c\uc628 \uc1fc\uce20\uac00 15\uac1c\ubfd0\uc774\ub77c \uadfc\uac70\uac00 \uc57d\ud558\ub2e4. \uace0\uac1d \ud655\uc778\uc774 \ud544\uc694\ud558\ub2e4.",
    "rules": "\uc804\uc0ac\uc5d0 \uc5c6\ub294 \uc0ac\uc2e4\u00b7\uc778\ubb3c\u00b7\ubc1c\uc5b8\uc744 \ucd94\uac00\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud55c \ud074\ub9bd\uc5d0 \uc8fc\uc81c \ud558\ub098. \ud328\ub110 \uac04 \uc8fc\uace0\ubc1b\ub294 \ub300\ud654\ub294 \ud55c \uc8fc\uc81c \uc548\uc5d0\uc11c\ub9cc \uc774\uc5b4 \ubd99\uc778\ub2e4. \uccab \ubb38\uc7a5\uc5d0\uc11c \ubb34\uc2a8 \uc598\uae30\uc778\uc9c0 \uc54c \uc218 \uc788\uac8c \uc2dc\uc791\ud558\uace0, \uc6c3\uc74c\uc774\ub098 \ud380\uce58\ub77c\uc778\uc774 \ub098\uc628 \ubb38\uc7a5\uc5d0\uc11c \ub05d\ub0b8\ub2e4. 15\uac1c \uc911 12\uac1c\uac00 \uc6c3\uc74c\uc774 \ud3ec\ud568\ub41c \uad6c\uac04\uc774\uc5c8\ub2e4. \uac8c\uc2a4\ud2b8 \uac00\uc218\ub098 \uad00\uc0c1 \ud480\uc774 \uac19\uc740 \uac00\ubcbc\uc6b4 \uc7a5\uba74\uc740 \uc815\uce58 \uc8fc\uc81c\uac00 \uc5c6\uc744 \ub54c\ub9cc \uace0\ub978\ub2e4. \uc870\uc0bc\ubaa8\uc0ac \uac19\uc740 \ud48d\uc790\ub294 \uc815\ucc45 \ub9e5\ub77d\uc774 \uac19\uc774 \ub4e4\uc5b4\uac00\uc57c \ud55c\ub2e4.",
    "headline": "\ub450 \uc904\uc774\uace0 \ud569\uccd0\uc11c 16-32\uc790(\uc911\uc559\uac12 27\uc790). \uac01 \uc904\uc740 16\uc790 \uc548\ud30e. \uccab \uc904\uc740 \ub300\uc0c1\uc774\ub098 \ub17c\uc810, \ub458\uc9f8 \uc904\uc740 \ud575\uc2ec \ubc1c\uc5b8\uc774\ub2e4. 15\uac1c \uc911 8\uac1c\uac00 \ud070\ub530\uc634\ud45c \uc778\uc6a9, 5\uac1c\uac00 \uc9c8\ubb38\ud615, 9\uac1c\uac00 \ub9d0\uc904\uc784\uc774\uc5c8\ub2e4. '!'\ub294 \uc4f0\uc9c0 \uc54a\uc558\ub2e4. \ud48d\uc790\ub294 \ubc1c\uc5b8\uc790\uc758 \ub9d0\uc744 \uadf8\ub300\ub85c \ub530\uc628\ub2e4. \uc778\uc6a9\uc740 \uc2e4\uc81c \ubc1c\uc5b8\uc77c \ub54c\ub9cc \uc4f4\ub2e4. \uc904\uc774 \ub118\uce60 \uacbd\uc6b0 \uc758\ubbf8\ub97c \ubcf4\uc874\ud574 \uc904\uc778\ub2e4."
  },
