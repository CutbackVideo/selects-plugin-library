    "host": "\ud719\uc54c\ud30c huick\uc758 \ud719\uc370 \u00b7 \ubb38\ud654\u00b7\uc0ac\ud68c\u00b7\uc5b8\uc5b4\u00b7\ube0c\ub79c\ub4dc \uc774\uc57c\uae30\ub97c \uc9c4\ud589\uc790\uac00 \uc790\ub8cc\uc640 \ud568\uaed8 \uc124\uba85\ud558\ub294 \uad50\uc591 \uc2dc\ub9ac\uc988"
