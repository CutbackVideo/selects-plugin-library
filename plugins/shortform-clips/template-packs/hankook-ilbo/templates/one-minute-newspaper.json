    "host": "\ud55c\uad6d\uc77c\ubcf4 \uc9c0\uba74\uc744 \ud655\ub300\u00b7\uc774\ub3d9\ud558\uba70 \uae30\uc0ac\ub97c \uc18c\uac1c\ud558\ub294 \ub0b4\ub808\uc774\uc158 \ub274\uc2a4"
