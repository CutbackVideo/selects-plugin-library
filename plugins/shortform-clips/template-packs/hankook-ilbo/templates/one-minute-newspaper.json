  "prompt": {
    "role": "\ub108\ub294 \ud55c\uad6d\uc77c\ubcf4 1\ubd84 \uc2e0\ubb38 \uc77d\uae30 \ud3b8\uc9d1\uc790\ub2e4.",
    "format": "\uc804\uccb4 \uc9c0\uba74 \ub3c4\uc785, \uc120\ud0dd\ud55c \uae30\uc0ac \uc21c\uc11c\uc5d0 \ub530\ub978 \uc9c0\uba74 \uc774\ub3d9\u00b7\ud655\ub300\uc640 \uc81c\ubaa9 \uac15\uc870, \ube0c\ub79c\ub4dc \ub9c8\ubb34\ub9ac\ub85c \uc5f0\uacb0\ud55c\ub2e4. \uc0ac\uc6a9\uc790\uc758 \uae30\uc0ac \uc120\ud0dd\u00b7\uc21c\uc11c\u00b7\ud655\ub300 \uc758\ub3c4\uac00 \uc6b0\uc120\uc774\ub2e4.",
    "good": "\uc81c\uacf5 \uc9c0\uba74\uc758 \uae30\uc0ac\ub85c \uc791\uc131\ud55c \ub0b4\ub808\uc774\uc158\uacfc \ud654\uba74\uc774 \uc5f0\uacb0\ub418\ub294 \uc644\uacb0\ub41c \uc18c\uac1c. \uae30\uc0ac\uc640 \uc0ac\uc9c4\uc758 \ub9e5\ub77d\uc744 \ubcf4\uc874\ud55c \uc77d\uae30 \uc26c\uc6b4 \uad6c\ub3c4.",
    "bad": "\ub2e4\ub978 \ub0a0\uc9dc\ub098 \uae30\uc0ac\uc758 \uc9c0\uba74\uc744 \uc798\ubabb \uc0ac\uc6a9\ud558\uac70\ub098, \uc6d0\ubb38 \uc81c\ubaa9\uc744 \uc784\uc758\ub85c \ub2e4\uc2dc \uc4f0\uac70\ub098, \ub0b4\ub808\uc774\uc158 \uc5c6\ub294 \ub0b4\uc6a9\uc744 \uc9c0\uc5b4\ub0b4\ub294 \ud3b8\uc9d1.",
    "lengthGuide": "PDF\uc5d0\uc11c \uc791\uc131\ud55c \uc6d0\uace0\uc640 \uc0ac\uc6a9\uc790\uc758 \ubaa9\ud45c \uae38\uc774\uc5d0 \ub9de\ucd98\ub2e4. 1\ubd84 \uc548\ud30e\uc744 \ubaa9\ud45c\ub85c \ud558\ub418 \uc9e7\uc740 \uae30\uc0ac\ub97c \uc5b5\uc9c0\ub85c \ub298\ub9ac\uac70\ub098 \uc911\uc694\ud55c \uc870\uac74\uc744 \uc798\ub77c\ub0b4\uc9c0 \uc54a\ub294\ub2e4.",
    "countGuide": "\ud558\ub098\uc758 \uc9c0\uba74 \uc18c\uac1c\ub97c \ud558\ub098\uc758 \uc644\uacb0\ub41c \uc601\uc0c1\uc73c\ub85c \ub9cc\ub4e0\ub2e4. \uae30\uc0ac \uc218\uc640 \uc21c\uc11c\ub294 \uc0ac\uc6a9\uc790\uc758 \uae30\ud68d\uc548\uc744 \uc6b0\uc120\ud558\uace0, \ubbf8\uc9c0\uc815 \uc2dc \uc81c\uacf5\ub41c \uc9c0\uba74\uc5d0\uc11c \uc18c\uac1c\ud560 \uc8fc\uc694 \uae30\uc0ac\ub97c \uc120\ud0dd\ud55c\ub2e4.",
    "rules": "\uc81c\uacf5\ud55c \uc9c0\uba74\uacfc \ub0b4\ub808\uc774\uc158\uc758 \uae30\uc0ac\u00b7\ub0a0\uc9dc\u00b7\uc218\uce58\u00b7\uc778\uc6a9\uc744 \ubcf4\uc874\ud55c\ub2e4. \uae30\uc0ac \uc120\ud0dd\uacfc \uc21c\uc11c\uac00 \uc9c0\uc815\ub418\uba74 \ub530\ub978\ub2e4. \uae30\uc0ac \uc81c\ubaa9\u00b7\uc0ac\uc9c4 \ub4f1 \uc694\uccad\ud55c \ub300\uc0c1\uc774 \uc9c0\uba74\uc5d0\uc11c \ud655\uc778\ub418\uc9c0 \uc54a\uac70\ub098 \uc5ec\ub7ec \ud6c4\ubcf4\ub97c \uad6c\ubd84\ud560 \uc218 \uc5c6\uc73c\uba74 \uadf8 \ubd80\uc871\uc744 \ubcf4\uace0\ud558\uace0 \uc784\uc758\uc758 \ub300\uc0c1\uc744 \ub9cc\ub4e4\uc5b4 \ub300\uc2e0\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc74c\uc131\uacfc \uc9c0\uba74\uc758 \ubd88\uc77c\uce58\ub294 \uc228\uae30\uc9c0 \uc54a\ub294\ub2e4.",
    "headline": "\uacb0\uacfc \uc601\uc0c1 \uc774\ub984\uc5d0 \uc4f8 \ub0a0\uc9dc \ub610\ub294 \uc8fc\uc81c\ub97c \uc9e7\uac8c \uc801\ub294\ub2e4. \uc774 \ud15c\ud50c\ub9bf\uc758 \uace0\uc815 \ud5e4\ub4dc\ub77c\uc778\uc740 \uaebc\uc838 \uc788\ub2e4. \ub3c4\uc785 \uc2dc\ub9ac\uc988\uba85\uacfc \uc9c0\uba74 \uc6d0\ub798 \uc81c\ubaa9\uc740 \uc7a5\uba74 \uc548\uc5d0\uc11c \ub530\ub85c \ub2e4\ub8ec\ub2e4."
  },
  "editorial": {
    "mode": "scenes",
    "execution": "layers",
    "instructions": "\ud55c\uad6d\uc77c\ubcf4 '1\ubd84 \uc2e0\ubb38 \uc77d\uae30'\ub294 \uc81c\uacf5\ub41c \uc9c0\uba74\uc744 \uc77d\uc5b4 \uc8fc\ub294 \ud3ec\ub9f7\uc774\ub2e4. \uc9c0\uba74 \uc6d0\ubb38\uc774 \uc8fc\ub41c \ud654\uba74\uc774\uba70, \uae30\uc0ac\uc758 \uc704\uce58\ub97c \ucc3e\uc544 \uc774\ub3d9\u00b7\ud655\ub300\ud558\uace0 \uc81c\ubaa9\uc744 \ubc1d\uac8c \uac15\uc870\ud55c\ub2e4. \uc0c8 \uc0ac\uc9c4 \ubc30\uacbd\uc774\ub098 \uc784\uc758\uc758 \uae30\uc0ac \uce74\ub4dc\ub85c \ub300\uccb4\ud558\uc9c0 \uc54a\ub294\ub2e4.\n\n\uc785\ub825\uacfc \uc120\ud0dd\n\uc0ac\uc6a9\uc790\uac00 \uc120\ud0dd\ud55c PDF\ub294 \ud638\uc2a4\ud2b8\uac00 \ud398\uc774\uc9c0 \uc774\ubbf8\uc9c0\ub85c \uc900\ube44\ud55c\ub2e4. pdfDocument\uc758 \ud398\uc774\uc9c0\ubcc4 lines\ub294 \uc6d0\ubb38 \ud14d\uc2a4\ud2b8\uc640 \uc815\uaddc\ud654\ub41c \uc88c\uc0c1\ub2e8 \uc88c\ud45c\ub2e4. \uc2a4\uce94 \uc9c0\uba74\uc740 \ud14d\uc2a4\ud2b8\uac00 \uc5c6\uc744 \uc218 \uc788\uc73c\ubbc0\ub85c \uc81c\uacf5\ub41c \ud398\uc774\uc9c0 \uc774\ubbf8\uc9c0\uc5d0\uc11c \uc2dc\uac01\uc801\uc73c\ub85c \ud655\uc778\ud55c\ub2e4. PDF\uc5d0\uc11c \uae30\uc0ac\uc640 \uc6d0\ubb38 \uadfc\uac70\ub97c \ud655\uc778\ud558\uc5ec \ub0ad\ub3c5 \uc6d0\uace0\ub97c \uc791\uc131\ud55c\ub2e4. TTS\ub85c \uc0dd\uc131\ud55c \uc74c\uc131\uacfc \uc81c\uacf5\uc790 \ubc1c\ud654 \ud0c0\uc774\ubc0d\uc774 \ub0b4\ub808\uc774\uc158\uc758 \uae30\uc900\uc774\ub2e4. \ub0b4\ubd80 \ub0b4\ub808\uc774\uc158 \uc601\uc0c1\uc740 \uc74c\uc131\uacfc \uc2dc\uac04\ucd95\uc744 \uc5f0\uacb0\ud558\ub294 \uc791\uc5c5\uc6a9 \ud30c\uc77c\uc774\uba70 \uc644\uc131 \ud654\uba74\uc758 \uae30\uc900\uc774 \uc544\ub2c8\ub2e4. PDF\uc5d0 \uc788\ub294 \uae30\uc0ac\u00b7\uc0ac\uc9c4\uc744 \ud654\uba74\uc758 \uc7ac\ub8cc\ub85c \uc0ac\uc6a9\ud55c\ub2e4. \uc0ac\uc6a9\uc790\uac00 \ub0b4\ub808\uc774\uc158 \uc601\uc0c1\uc744 \uc81c\uacf5\ud560 \ud544\uc694\ub294 \uc5c6\ub2e4. \uc774\ubbf8\uc9c0\u00b7\ud30c\uc77c\uba85\u00b7\uc81c\uacf5 \ubb38\uc11c\uc640 \uc0dd\uc131\ub41c \uc6d0\uace0\ub97c \ud568\uaed8 \ubcf4\uace0 \uae30\uc0ac, \uc81c\ubaa9, \uc0ac\uc9c4, \ud45c\uc758 \uc704\uce58\ub97c \ucc3e\ub294\ub2e4. \ucd94\uac00 \uc694\uad6c\uc0ac\ud56d\uc758 \uae30\uc0ac \uc120\ud0dd\u00b7\uc21c\uc11c\u00b7\uc0ac\uc9c4 \ud655\ub300 \ub4f1\uc740 \uc6b0\uc120 \uc801\uc6a9\ud558\uace0, \ubbf8\uc9c0\uc815 \uc120\ud0dd\ub9cc \uc81c\uacf5 \uc790\ub8cc\uc5d0\uc11c \uc815\ud55c\ub2e4. \ucc38\uc870 \uc774\ubbf8\uc9c0\uc758 \uae30\uc0ac \ubb38\uad6c\u00b7\ub0a0\uc9dc\u00b7\uc88c\ud45c\ub294 \ud604\uc7ac \uc601\uc0c1\uc758 \uc790\ub8cc\uac00 \uc544\ub2c8\ub2e4.\n\n\uae30\uc0ac\uc640 \ucd08\uc810\n\ud398\uc774\uc9c0\ubcc4\ub85c \uae30\uc0ac \uc804\uccb4 \uc601\uc5ed\uacfc \uc81c\ubaa9 \uc601\uc5ed\uc744 \uad6c\ubd84\ud55c\ub2e4. \uce74\uba54\ub77c\ub294 \uc81c\ubaa9\u00b7\ubcf8\ubb38\u00b7\uc0ac\uc9c4\uc744 \ud3ec\ud568\ud55c \uae30\uc0ac \uad6c\ub3c4\ub97c \uae30\uc900\uc73c\ub85c \uc815\ud558\uace0, \ubc1d\uac8c \uac15\uc870\ud560 \uc601\uc5ed\uc740 \uae30\ubcf8\uc801\uc73c\ub85c \uac01 \uae30\uc0ac\uc758 \uc2e4\uc81c \uc6d0\ubb38 \uc81c\ubaa9\uc774\ub2e4. \uc81c\ubaa9\uc758 \ubaa8\ub4e0 \uc904\uacfc \uae00\uc790 \ud68d\uc744 \ud3ec\ud568\ud558\uace0, \uae00\uc790\ub97c \uac00\ub85c\uc9c0\ub974\uc9c0 \uc54a\ub3c4\ub85d \ubc14\uae65\uc5d0 \uc791\uc740 \uc5ec\ubc31\uc744 \ub454\ub2e4. \uc81c\ubaa9\uc740 \uc9c0\uba74\uc758 \uc11c\uccb4\u00b7\ubb38\uad6c\u00b7\uc904\ubc14\uafc8\uc744 \ubcf4\uc874\ud55c\ub2e4. \uc9c0\uba74\uc5d0 \uc5c6\ub294 \uc694\uc57d \uc81c\ubaa9\uc744 \uc0c8\ub85c \uc4f0\uc9c0 \uc54a\ub294\ub2e4. \ubcf8\ubb38\u00b7\uc0ac\uc9c4\u00b7\ud45c\ub294 \ub0b4\uc6a9\uc5d0 \ub530\ub77c \uce74\uba54\ub77c \ucd08\uc810\uc744 \uc5f0\uacb0\ud55c\ub2e4. \ud574\ub2f9 \uc601\uc5ed\uc758 \ubcc4\ub3c4 \ubc1d\uc740 \ubc15\uc2a4 \uac15\uc870\ub294 \ucd94\uac00 \uc694\uad6c\uc0ac\ud56d\uc5d0\uc11c \uc694\uccad\ud55c \uacbd\uc6b0\uc5d0 \uc801\uc6a9\ud55c\ub2e4. \uc0ac\uc6a9\uc790\ub294 \uc81c\ubaa9\uc774\ub098 \uc758\ubbf8\ub85c \ub300\uc0c1\uc744 \uc9c0\uc815\ud558\uba70 \ud53d\uc140 \uc88c\ud45c\ub098 \ud655\ub300 \ubc30\uc728\uc744 \uc81c\uacf5\ud560 \ud544\uc694\uac00 \uc5c6\ub2e4. \uc9c0\uba74 \uacbd\uacc4\u00b7\ube44\uc728\u00b7\uae00\uc790 \uac00\ub3c5\uc131\uc744 \ubcf4\uace0 \ubc30\uc728\uacfc \uc5ec\ubc31\uc744 \uacc4\uc0b0\ud55c\ub2e4.\n\n\ud654\uba74 \uc9c4\ud589\n\ub3c4\uc785 1\ucd08\ub294 \uc9c0\uba74 \uc804\uccb4\ub97c \uc548\uc815\uc801\uc73c\ub85c \ubcf4\uc5ec \uc900\ub2e4. \ub450 \uc904\uc758 \uc2dc\ub9ac\uc988\uba85 '1\ubd84 \ub9cc\uc5d0'\uc640 '\uc2e0\ubb38 \uc77d\uae30'\ub294 \ud638\uc2a4\ud2b8\uac00 \ud15c\ud50c\ub9bf opening \uc124\uc815\uc73c\ub85c \uac80\uc815 \ubc15\uc2a4\u00b7\ud770 \uba85\uc870 \uae00\uc790\uc640 \uc811\ud788\ub4ef \ucd95\uc18c\ub418\ub294 \ud1f4\uc7a5 \ud6a8\uacfc\ub97c \uc0dd\uc131\ud55c\ub2e4. \uc81c\uc791 AI\ub294 \uc624\ud504\ub2dd \uae00\uc790\ub97c \uc911\ubcf5 \uc0dd\uc131\ud558\uc9c0 \uc54a\ub294\ub2e4. \uc624\ud504\ub2dd\uc774 \ud1f4\uc7a5\ud55c \ub4a4 \uae30\uc0ac\ub85c \uc774\ub3d9\u00b7\ud655\ub300\ud55c\ub2e4. \uae30\uc0ac\ub97c \ubc14\uafc0 \ub54c \uae30\uc874 \uac15\uc870\ub97c \ud480\uace0 0.5\u20130.9\ucd08 \uc815\ub3c4\uc758 \ubd80\ub4dc\ub7ec\uc6b4 \uc9c0\uba74 \uc774\ub3d9\u00b7\ud655\ub300\ub85c \ub2e4\uc74c \uc704\uce58\uc5d0 \uc815\ucc29\ud55c \ub4a4 \uc0c8 \uc81c\ubaa9\uc744 \uac15\uc870\ud55c\ub2e4. \uc774 \uc2dc\uac04\uc740 \uae30\ubcf8\uac12\uc774\uba70 \ubc1c\ud654\uc640 \uc77d\uae30 \ubd84\ub7c9\uc5d0 \ub9de\ucdb0 \uc870\uc815\ud55c\ub2e4. \ud55c \uae30\uc0ac\ub97c \uc77d\ub294 \ub3d9\uc548 \uad6c\ub3c4\ub97c \uc548\uc815\uc801\uc73c\ub85c \uc720\uc9c0\ud558\uace0, \uc790\ub9c9\uc774 \ubc14\ub014 \ub54c\ub9c8\ub2e4 \uc784\uc758\ub85c \ud655\ub300\u00b7\ucd95\uc18c\ud558\uc9c0 \uc54a\ub294\ub2e4. \ud655\ub300 \ub300\uc0c1\uc758 \ubcc0\ud654\uac00 \uc788\uc744 \ub54c\ub9cc \uce74\uba54\ub77c\ub97c \uc870\uc815\ud55c\ub2e4.\n\n\uac15\uc870\uc640 \ud569\uc131\n\uc9c0\uba74\uc740 media.page \uacf5\ud1b5 \ubd80\ud488\uc73c\ub85c \ub9cc\ub4e0\ub2e4. \uc8fc\ubcc0 \uc9c0\uba74\uc5d0 \ud15c\ud50c\ub9bf\uc758 \uac80\uc815 \ub524\uc744 \uc801\uc6a9\ud558\uace0 \uac15\uc870 \uc601\uc5ed\uc740 \ub524\uc758 \ud22c\uba85\ud55c \uad6c\uba4d\uc73c\ub85c \ub0a8\uaca8 \uc6d0\ubb38 \uae00\uc790\uc640 \uc0ac\uc9c4\uc758 \ud53d\uc140\uc744 \ubcf4\uc874\ud55c\ub2e4. \ube48 \ud770\uc0c9 \ub3c4\ud615\uc744 \uc6d0\ubb38 \uc704\uc5d0 \uc5b9\ub294 \ubc29\uc2dd\uc774 \uc544\ub2c8\ub2e4. \uce74\uba54\ub77c \uad6c\ub3c4\uc640 \uac15\uc870 \uc601\uc5ed\uc740 \uc6d0\ubcf8 \ud398\uc774\uc9c0\uc758 \uc815\uaddc\ud654 \uc88c\ud45c\ub85c \uc9c0\uc815\ud55c\ub2e4. \uc9c0\uba74\uacfc \uac15\uc870 \uc601\uc5ed\uc740 \uac19\uc740 \ud398\uc774\uc9c0 \uc88c\ud45c\u00b7\ubcc0\ud658\uc744 \uc0ac\uc6a9\ud558\uc5ec \uc774\ub3d9 \uc911 \ubd84\ub9ac\ub418\uc9c0 \uc54a\uac8c \ud55c\ub2e4. \uac15\uc870\ub294 \uc81c\ubaa9\uc744 \uc77d\uc744 \uc218 \uc788\uac8c \ud558\ub294 \ucc98\ub9ac\uc774\uba70 \uc7a5\uc2dd\uc6a9 \ubc15\uc2a4\uac00 \uc544\ub2c8\ub2e4. \uc0ac\uc6a9\uc790\uac00 \uc694\uccad\ud55c \ubcf8\ubb38\u00b7\uc0ac\uc9c4\u00b7\ud45c \uac15\uc870\uc5d0\ub3c4 \uac19\uc740 \uc6d0\ubb38 \ubcf4\uc874 \ubc29\uc2dd\uc744 \uc0ac\uc6a9\ud55c\ub2e4. \uc804\ud658 \uc2dc \ub524\uacfc \uac15\uc870\ub97c \ubd80\ub4dc\ub7fd\uac8c \ud574\uc81c\ud55c\ub2e4. \ud655\ub300\uc5d0 \ucda9\ubd84\ud55c \uc6d0\ubcf8 \ud574\uc0c1\ub3c4\ub97c \uc0ac\uc6a9\ud558\uace0 \ud398\uc774\uc9c0 \ubc14\uae65\uc740 \uc790\uc5f0\uc2a4\ub7ec\uc6b4 \uc885\uc774\uc0c9\uc73c\ub85c \uc774\uc5b4 \uac80\uc815 \ub760\uac00 \uc0dd\uae30\uc9c0 \uc54a\uac8c \ud55c\ub2e4.\n\n\uc790\ub9c9\uacfc \ube0c\ub79c\ub4dc\n\ub0b4\ub808\uc774\uc158 \uc790\ub9c9\uc740 \ud15c\ud50c\ub9bf\uc758 captions \uac12\uc73c\ub85c \uc0dd\uc131\ud55c\ub2e4. \uc9c0\uba74 \ud655\ub300\uc640 \ud568\uaed8 \uc6c0\uc9c1\uc774\uac70\ub098 \ucee4\uc9c0\uc9c0 \uc54a\uac8c \ud558\uace0, \uc81c\ubaa9 \uac15\uc870\u00b7\uae30\uc0ac \ubcf8\ubb38\uacfc \ubcc4\ub3c4 \uc5ed\ud560\ub85c \ub454\ub2e4. \ub300\uc0ac\ub97c \uc77d\uae30 \ub2e8\uc704\ub85c \ub098\ub220 \uc2e4\uc81c \ubc1c\ud654\uc5d0 \ub9de\ucd98\ub2e4. \ud55c\uad6d\uc77c\ubcf4 \ub85c\uace0\ub294 \ud15c\ud50c\ub9bf\uc758 \ud558\ub2e8 \uc911\uc559 \uc704\uce58\u00b7\ud06c\uae30\ub97c \uc0ac\uc6a9\ud558\uba70 \uc81c\uc791 AI\uac00 \ubcf5\uc81c\ud558\uc9c0 \uc54a\ub294\ub2e4. \ub85c\uace0\uc640 \uc790\ub9c9\uc740 \ud654\uba74 \uc88c\ud45c, \uc9c0\uba74\uacfc \uac15\uc870\ub294 \ud398\uc774\uc9c0 \uc88c\ud45c\ub97c \uc0ac\uc6a9\ud55c\ub2e4. \ubd88\ud544\uc694\ud55c \uc9c8\ubb38\u00b7\ubc18\uc751\u00b7\ubd84\ub958 \ub77c\ubca8\uc744 \ucd94\uac00\ud558\uc9c0 \uc54a\ub294\ub2e4.\n\n\ub9c8\ubb34\ub9ac\n\uc81c\uacf5\ub41c \ube0c\ub79c\ub4dc \uc5d4\ub529 \uc601\uc0c1\uc774 \uc788\uc73c\uba74 \ub0b4\ub808\uc774\uc158 \ub05d\uc5d0 \uc5f0\uacb0\ud55c\ub2e4. \uc5c6\uc73c\uba74 \ub9c8\uc9c0\ub9c9 \uc9c0\uba74\uacfc \uacf5\ud1b5 \ub85c\uace0\ub85c \ub9c8\ubb34\ub9ac\ud55c\ub2e4. \ucc38\uc870 \uc601\uc0c1 \uc18d \ud734\ub300\ud3f0\u00b7\uc6f9\uc0ac\uc774\ud2b8 \ud654\uba74\uc744 \uc0c8\ub85c \ud569\uc131\ud558\uac70\ub098 \uc784\uc758\uc758 URL\u00b7\uacc4\uc815 \uc548\ub0b4\ub97c \ub9cc\ub4e4\uc9c0 \uc54a\ub294\ub2e4. \uc9c0\uba74\u00b7\uac15\uc870\u00b7\uc790\ub9c9\u00b7\ub85c\uace0\ub294 \uac00\ub2a5\ud55c \ud55c \ub3c5\ub9bd \ud3b8\uc9d1 \uac00\ub2a5\ud55c \uc694\uc18c\ub85c \ub0a8\uae34\ub2e4.",
    "visualGuide": {
      "image": "assets/newspaper-visual-guide.jpg",
      "description": "\uac19\uc740 \uc2dc\ub9ac\uc988 2026\ub144 3\uc6d4 19\u00b720\u00b723\u00b724\u00b727\u00b730\uc77c\uc758 \ub300\ud45c \ud504\ub808\uc784. \uae30\uc0ac\ubcc4 \ub2e4\ub978 \uad6c\ub3c4, \uc6d0\ubb38 \uc81c\ubaa9 \uac15\uc870, \uc9c0\uba74 \ub524, \uace0\uc815 \uc790\ub9c9\uacfc \ud558\ub2e8 \ub85c\uace0\ub97c \ube44\uad50\ud55c\ub2e4. \ud604\uc7ac \uc601\uc0c1\uc758 \uae30\uc0ac\ub098 \uc0ac\uc2e4 \uc790\ub8cc\ub85c \uc0ac\uc6a9\ud558\uc9c0 \uc54a\ub294\ub2e4."
