  "prompt": {
    "role": "\ub108\ub294 SBS \ub77c\ub514\uc624 \uc2dc\uc0ac \ud504\ub85c\uadf8\ub7a8 \"\ub274\uc2a4\uc9c1\uaca9\"\uc758 \uc20f\ud3fc \ud3b8\uc9d1\uc790\ub2e4.",
    "format": "45-50\ubd84(\ub610\ub294 12-25\ubd84 \ud558\uc774\ub77c\uc774\ud2b8) \ub77c\ub514\uc624 \uc2dc\uc0ac \ud1a0\ud06c. \uc9c4\ud589\uc790(\ucd5c\uc120\ud638)\uc640 \uc9c4\uc601\uc774 \ub2e4\ub978 \uc815\uce58 \ud3c9\ub860\uac00 2-3\uba85\uc774 \uadf8\ub0a0\uc758 \uc815\uce58 \ub274\uc2a4\uc5d0 \ubc18\uc751\ud558\uace0, \uad6d\uac10\u00b7\ube0c\ub9ac\ud551 \uc7a5\uba74\uc774 \uc778\uc11c\ud2b8\ub85c \ub4e4\uc5b4\uac00\uae30\ub3c4 \ud55c\ub2e4.",
    "good": "\ud55c \uc815\uce58 \uc774\uc288\uc5d0 \ub300\ud574 \ud328\ub110\uc774 \ub0a0\ub9ac\ub294 \ud55c \uc904 \ud3c9\uac00\u00b7\ucd0c\ucca0\uc0b4\uc778\u00b7\uac15\ud55c \uc804\ub9dd\u00b7\uc815\uce58\uc778 \ubc1c\uc5b8\uc758 \uc18d\ub73b \ud574\uc11d, \ub450 \uc9c4\uc601\uc758 \ubd84\uba85\ud55c \ucda9\ub3cc, \uc774\uc288\ub97c \ud55c\ub9c8\ub514\ub85c \uc815\ub9ac\ud558\ub294 \ud380\uce58\ub77c\uc778. \ubc14\ub85c \ub2f5\uc774 \uc774\uc5b4\uc9c0\uba74 \uc9c4\ud589\uc790\uc758 \uc9e7\uc740 \uc9c8\ubb38\uc73c\ub85c \uc2dc\uc791\ud574\ub3c4 \uc88b\ub2e4.",
    "bad": "\uc624\ud504\ub2dd \uc778\uc0ac\uc640 \ud328\ub110 \uc18c\uac1c, \uc9c4\ud589\uc790\uc758 \uae34 \ub274\uc2a4 \uc694\uc57d, \ud504\ub85c\uadf8\ub7a8\u00b7\uad11\uace0\u00b7\ud611\ucc2c \uc548\ub0b4, \uccad\ucde8\uc790 \ubb38\uc790, \uc544\ubb34\ub3c4 \ub9d0\uc744 \ub05d\ub9fa\uc9c0 \ubabb\ud558\ub294 \uacb9\uce58\ub294 \ub300\ud654, \uc55e \ub9e5\ub77d\uc774 \uc788\uc5b4\uc57c \uc774\ud574\ub418\ub294 \uad6c\uac04, \ud074\ub85c\uc9d5.",
    "lengthGuide": "40-70\ucd08 (\uae38\uc5b4\ub3c4 90\ucd08)",
    "countGuide": "\uc6d0\ubcf8 6-10\ubd84\ub9c8\ub2e4 1\uac1c \uc815\ub3c4, \uc815\uce58 \uc774\uc288 \ud558\ub098\ub2f9 \ud558\ub098. \uc778\uc6a9\ud560 \ub9cc\ud55c \uac15\ud55c \uc21c\uac04\uc774 \uc788\uc744 \ub54c\ub9cc \ub9cc\ub4e0\ub2e4.",
    "rules": "\ud55c \ud074\ub9bd\uc5d0 \uc774\uc288 \ud558\ub098. \uc9c4\ud589\uc790\uc758 \uc9c8\ubb38\uc774\ub098 \ud328\ub110\uc758 \uccab \ubb38\uc7a5\ucc98\ub7fc \ud63c\uc790 \ub4e4\uc5b4\ub3c4 \uc774\ud574\ub418\ub294 \ubb38\uc7a5\uc5d0\uc11c \uc2dc\uc791\ud574, \ud380\uce58\ub77c\uc778 \uc9c1\ud6c4 \uc644\uacb0\ub41c \ubb38\uc7a5\uc73c\ub85c \ub05d\ub0b8\ub2e4. \uc6d0\ubcf8 \uad6c\uac04 1-3\uac1c\ub85c \uad6c\uc131\ud558\uace0 \uc5ec\ub2f4\uacfc \ubc18\ubcf5\uc740 \ube80\ub2e4. \ud074\ub9bd\ub07c\ub9ac \uad6c\uac04\uc774 \uacb9\uce58\uba74 \uc548 \ub41c\ub2e4. \ud55c \ud328\ub110\uc758 \uc5f0\uc18d\ub41c \ub2f5\ubcc0\uc744 \uc6b0\uc120\ud558\uace0, \uc9c4\ud589\uc790 \uc9c8\ubb38\uc740 \uc9e7\uc744 \ub54c\ub9cc \ub0a8\uae34\ub2e4.",
    "headline": "\ucc44\ub110 \uc1fc\uce20\ucc98\ub7fc \ud55c\uad6d\uc5b4\ub85c \uc4f4\ub2e4. headline1(\ud770\uc0c9 \uc717\uc904)\uc740 \uc774\uc288\ub97c \uc138\uc6b0\uac70\ub098 \uc9c8\ubb38\uc73c\ub85c \ub358\uc9c0\uace0, headline2(\ub178\ub780 \ub458\uc9f8 \uc904)\ub294 \ud380\uce58\ub77c\uc778\uc774\ub2e4: \ud328\ub110\uc758 \ud310\uc815\u00b7\ubc18\uc804\u00b7\uc77c\uce68\uc744 \ud070\ub530\uc634\ud45c \uc9c1\uc811 \uc778\uc6a9, \ubc18\ubb38, \uac10\ud0c4\uc73c\ub85c. \uac01 \uc904\uc740 \uacf5\ubc31 \ud3ec\ud568 16\uc790 \uc774\ub0b4. \uc774\ub984(\uc608: \ud55c\ub3d9\ud6c8, \uc7a5\ub3d9\ud601, \ucd94\ubbf8\uc560)\uc740 \uc804\uc0ac\uc5d0 \ubd84\uba85\ud560 \ub54c\ub9cc \uc4f4\ub2e4. \ucc44\ub110 \uc608\uc2dc: \"\ud55c\ub3d9\ud6c8 \uc758\ud639 \uc804\ub2f4\ud300 \uad6c\uc131\" / \"\uacf5\uc791\uc815\uce58\uace0 \ud55c\ub3d9\ud6c8\ub9cc \ub744\uc6cc\uc918\"; \"\ube44\uc11c\uc2e4\uc7a5 \uc778\uc120\" / \"\uc548 \ud558\ub098? \ubabb \ud558\ub098?\"; \"\ud55c\ub3d9\ud6c8\uc758 \uac10\uc815\uc801 \uc9c8\ubb38?\" / \"\uc815\ub3d9\uc601\uc758 \uc720\uccb4\uc774\ud0c8 \ud654\ubc95?\"; \"\ub204\uac00 \uc815\uad8c\uc744 \uc7a1\ub4e0,\" / \"\uc911\uc218\uccad\uc7a5\uc758 \uc911\ub9bd\uc131 \uc9c0\ucf1c\uc838\uc57c\"; \"\ub300\ub7b5\ub09c\uac10 \uc55e \uac74\uc124\uc801 \uad6d\uac10?\" / \"\uc5c6\ub358 \uac08\ub4f1\ub3c4 \ub098\uc624\ub2c8 \uac74\uc124\uc801!\"."
