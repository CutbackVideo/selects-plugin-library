{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Window-local active-speaker observations",
  "type": "object",
  "required": [
    "contractVersion",
    "task",
    "samples",
    "frameSize",
    "scoreKind",
    "trackingScope"
  ],
  "properties": {
    "contractVersion": {
      "const": 1
    },
    "task": {
      "const": "speakers.detect"
    },
    "scoreKind": {
      "const": "uncalibrated-logit"
    },
    "trackingScope": {
      "const": "three-second-window"
    },
    "samples": {
      "type": "array",
      "minItems": 1
    },
    "frameSize": {
      "type": "object"
    }
  }
}
