      ],
      "referenceSource": "import {AbsoluteFill, useCurrentFrame, useVideoConfig} from \"remotion\";\n\nfunction smooth(t) {\n  const x = Math.max(0, Math.min(1, t));\n  return x * x * (3 - 2 * x);\n}\n\nfunction numberOf(d, key, fallback) {\n  const raw = d[key];\n  return typeof raw === \"number\" ? raw : fallback;\n}\n\n/**\n * How far the clip is from being clear: 0 at the affected edge, 1 once the\n * window has passed. An \"out\" counts from the tail instead of the head, which\n * is the only difference between arriving and leaving.\n */\nfunction clearness(d, fps, rangeDurationInFrames, frame) {\n  const seconds = numberOf(d, \"span\", 0.6);\n  const span = Math.max(1, Math.round(seconds * fps));\n  const total = rangeDurationInFrames > 0 ? rangeDurationInFrames : 150;\n  const leaving = (typeof d.direction === \"string\" ? d.direction : \"in\") === \"out\";\n  const into = leaving ? total - 1 - frame : frame;\n  return smooth(Math.max(0, Math.min(1, into / span)));\n}\n\nexport default function Reveal({Source, data, rangeDurationInFrames}) {\n  const d = data ?? {};\n  const {fps} = useVideoConfig();\n  const style = typeof d.style === \"string\" ? d.style : \"fade\";\n  const p = clearness(d, fps, rangeDurationInFrames, useCurrentFrame());\n  // How much of the treatment is still on the frame.\n  const k = 1 - p;\n  const amount = Math.max(0, Math.min(100, numberOf(d, \"amount\", 60))) / 100;\n\n  if (style === \"blackout\") {\n    return <AbsoluteFill style={{ background: \"#000000\" }} />;\n  }\n\n  if (style === \"glitch\") {\n    const shift = k * amount * 6;\n    return (\n      <AbsoluteFill style={{ opacity: 0.4 + p * 0.6 }}>\n        <AbsoluteFill><Source /></AbsoluteFill>\n        {k <= 0.01 ? null : (\n          <AbsoluteFill style={{ mixBlendMode: \"screen\", opacity: k, transform: \"translateX(\" + shift + \"%)\", filter: \"brightness(1.1)\" }}>\n            <AbsoluteFill style={{ background: \"#ff0040\", mixBlendMode: \"multiply\" }} />\n            <Source />\n          </AbsoluteFill>\n        )}\n        {k <= 0.01 ? null : (\n          <AbsoluteFill style={{ mixBlendMode: \"screen\", opacity: k, transform: \"translateX(\" + -shift + \"%)\" }}>\n            <AbsoluteFill style={{ background: \"#00e5ff\", mixBlendMode: \"multiply\" }} />\n            <Source />\n          </AbsoluteFill>\n        )}\n        {k <= 0.01 ? null : (\n          <AbsoluteFill style={{\n            pointerEvents: \"none\",\n            opacity: k * 0.5,\n            background: \"repeating-linear-gradient(0deg, rgba(0,0,0,0.6) 0 2px, transparent 2px 6px)\",\n          }} />\n        )}\n      </AbsoluteFill>\n    );\n  }\n\n  if (style === \"softMask\") {\n    // A feathered wipe: the hard edge is the reveal, the soft band is the\n    // amount, and at rest the whole frame is inside the mask.\n    const feather = 4 + amount * 40;\n    const edge = p * (100 + feather);\n    const gradient =\n      \"linear-gradient(90deg, #000 \" + Math.max(0, edge - feather) + \"%, transparent \" + edge + \"%)\";\n    return (\n      <AbsoluteFill style={{\n        maskImage: gradient,\n        WebkitMaskImage: gradient,\n      }}>\n        <Source />\n      </AbsoluteFill>\n    );\n  }\n\n  // A blur is a real filter; a pixel treatment has no CSS primitive, so it is a\n  // heavy blur held together with contrast \u2014 coarse in the same direction.\n  const blur = style === \"pixel\" ? k * amount * 26 : k * amount * 24;\n  const contrast = style === \"pixel\" ? 1 + k * amount * 0.9 : 1;\n  const fades = style === \"fade\" || style === \"blurFade\";\n  const blurs = style !== \"fade\";\n\n  // A filter costs a compositing layer for as long as it is set, so it comes off\n  // entirely once there is nothing left to blur \u2014 which is most of the clip.\n  const filtering = blurs && (blur > 0.01 || contrast !== 1);\n  return (\n    <AbsoluteFill style={{\n      opacity: fades ? p : 1,\n      filter: filtering ? \"blur(\" + blur + \"px) contrast(\" + contrast + \")\" : undefined,\n    }}>\n      <Source />\n    </AbsoluteFill>\n  );\n}"
